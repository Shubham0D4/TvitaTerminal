// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  TEAM_MEMBER
  CLIENT
}

enum TeamRole {
  TEAM_LEAD
  DEVELOPER
  TESTER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  CLIENT_REVIEW
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  CLIENT_REVIEW
  APPROVED
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  READY_FOR_TESTING
  IN_TESTING
  CHANGES_REQUIRED
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Visibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum ClientApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ClientTeamStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

enum ClientPriority {
  LOW
  MEDIUM
  HIGH
  VIP
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

// ─────────────────────────────────────────────
// PROFILE (extends Supabase auth.users)
// ─────────────────────────────────────────────

model Profile {
  id        String    @id @db.Uuid // matches auth.users.id
  role      Role
  teamRole  TeamRole? @map("team_role")
  name      String
  email     String    @unique
  phone     String?
  avatarUrl String?   @map("avatar_url")
  salary    Decimal?  @map("salary") @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  clientProfile        Client?        @relation("ClientProfile")
  clientsCreated       Client[]       @relation("ClientCreatedBy")
  clientsManaged       Client[]       @relation("ClientAccountManager")
  clientsUpdated       Client[]       @relation("ClientUpdatedBy")
  projectsLed          Project[]      @relation("ProjectLead")
  projectsCreated      Project[]      @relation("ProjectCreatedBy")
  projectMembers       ProjectMember[]
  tasksAssigned        Task[]         @relation("TaskAssignee")
  tasksDeveloped       Task[]         @relation("TaskDeveloper")
  tasksTested          Task[]         @relation("TaskTester")
  tasksCreated         Task[]         @relation("TaskCreatedBy")
  taskComments         TaskComment[]
  taskActivities       TaskActivity[]
  invoicesCreated      Invoice[]
  documentsUploaded    Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  projectUpdates       ProjectUpdate[]
  subscriptionsCreated Subscription[]
  milestonesAssigned   Milestone[]    @relation("MilestoneAssignee")
  milestonesCreated    Milestone[]    @relation("MilestoneCreatedBy")
  approvalsCreated     ClientApproval[] @relation("ApprovalCreatedBy")
  clientSubTeam        ClientSubTeam? // If this profile is a sub-team login

  @@map("profiles")
}

// ─────────────────────────────────────────────
// CLIENT (organization)
// ─────────────────────────────────────────────

model Client {
  id            String       @id @default(uuid()) @db.Uuid

  // ── 1. Basic Information
  clientType    ClientType   @default(ORGANIZATION) @map("client_type")
  legalName     String?      @map("legal_name")                   // Legal / Full Name
  displayName   String?      @map("display_name")                 // Business / Trade Name
  country       String?                                           // ISO-2 code e.g. "IN", "US"
  stateProvince String?      @map("state_province")
  city          String?
  timezone      String?
  industry      String?
  website       String?

  // ── 2. Contact Information
  contactPerson String?      @map("contact_person")               // Primary Contact Name (kept for compat)
  designation   String?                                           // Designation / Role
  email         String?                                           // Primary email
  phone         String?
  whatsapp      String?
  preferredComm String?      @map("preferred_comm")               // email | phone | whatsapp | slack

  // ── 3. Address Information
  address           String?                                       // Billing Address (kept for compat)
  registeredAddress String?  @map("registered_address")
  billingCity       String?  @map("billing_city")
  billingState      String?  @map("billing_state")
  billingCountry    String?  @map("billing_country")              // ISO-2 if different from country
  postalCode        String?  @map("postal_code")

  // ── 4. Legal & Registration
  entityType              String?  @map("entity_type")            // Pvt Ltd, LLP, Sole Trader, etc.
  registrationNo          String?  @map("registration_no")
  countryOfRegistration   String?  @map("country_of_registration")
  taxId                   String?  @map("tax_id")                 // Generic Tax ID
  pan                     String?                                 // PAN (India)
  gstin                   String?                                 // GSTIN / VAT Number
  vatNumber               String?  @map("vat_number")             // VAT (International)
  authorizedRep           String?  @map("authorized_rep")

  // ── 5. Billing & Tax
  billingName   String?      @map("billing_name")
  billingEmail  String?      @map("billing_email")
  currency      String       @default("INR")
  taxApplicable Boolean      @default(true) @map("tax_applicable")
  taxRate       Decimal?     @map("tax_rate") @db.Decimal(5, 2)
  poRequired    Boolean      @default(false) @map("po_required")
  poNumber      String?      @map("po_number")
  paymentTerms  String?      @map("payment_terms")                // Net 30, Net 15, etc.

  // ── 6. Payment Information
  paymentMethod       String?  @map("payment_method")             // bank_transfer | stripe | paypal | etc.
  paymentReference    String?  @map("payment_reference")
  paymentProvider     String?  @map("payment_provider")
  paymentInstructions String?  @map("payment_instructions")
  txnFeeResponsibility String? @map("txn_fee_responsibility")     // agency | client | split

  // ── 7. Internal / Admin
  clientSource    String?         @map("client_source")           // referral | direct | linkedin | etc.
  clientPriority  ClientPriority  @default(MEDIUM) @map("client_priority")
  accountManagerId String?        @map("account_manager_id") @db.Uuid
  internalTags    String[]        @map("internal_tags")           // stored as array
  internalNotes   String?         @map("internal_notes")
  riskLevel       RiskLevel       @default(LOW) @map("risk_level")

  // ── 8. System / Status
  name              String                                        // kept as display-compatible alias
  status            ClientStatus      @default(ACTIVE)
  onboardingStatus  OnboardingStatus  @default(PENDING) @map("onboarding_status")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  profileId         String?   @unique @map("profile_id") @db.Uuid
  createdById       String?   @map("created_by") @db.Uuid
  updatedById       String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  profile        Profile?        @relation("ClientProfile", fields: [profileId], references: [id])
  createdBy      Profile?        @relation("ClientCreatedBy", fields: [createdById], references: [id])
  accountManager Profile?        @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  updatedBy      Profile?        @relation("ClientUpdatedBy", fields: [updatedById], references: [id])
  projects       Project[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  documents      Document[]
  contacts       ClientContact[]
  clientDocs     ClientDocument[]
  approvals      ClientApproval[]
  privatePlans   Plan[]           @relation("ClientPrivatePlans")
  subTeams       ClientSubTeam[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// CLIENT SUB-TEAMS (client-owned internal teams)
// ─────────────────────────────────────────────

model ClientSubTeam {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  name         String           // Team display name
  email        String           @unique  // Login email for this sub-team
  profileId    String           @unique @map("profile_id") @db.Uuid // Supabase auth profile
  status       ClientTeamStatus @default(ACTIVE)
  // accessPolicy: JSON object controlling what pages/data this team can see
  // Default: { projects: true, milestones: true, approvals: true, invoices: false, subscriptions: false, billing: false }
  accessPolicy Json             @default("{}") @map("access_policy")
  revokedByAdmin Boolean        @default(false) @map("revoked_by_admin") // Admin revoke flag
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("client_sub_teams")
}

// ─────────────────────────────────────────────
// CLIENT CONTACTS (repeatable additional contacts)
// ─────────────────────────────────────────────

model ClientContact {
  id                String  @id @default(uuid()) @db.Uuid
  clientId          String  @map("client_id") @db.Uuid
  name              String
  role              String?                   // Finance, Technical, Legal, etc.
  designation       String?
  email             String?
  phone             String?
  isDecisionMaker   Boolean @default(false) @map("is_decision_maker")
  createdAt         DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

// ─────────────────────────────────────────────
// CLIENT DOCUMENTS (client-specific with expiry/verification)
// ─────────────────────────────────────────────

model ClientDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  clientId           String             @map("client_id") @db.Uuid
  name               String
  documentType       String?            @map("document_type")  // Contract, NDA, SOW, GST Cert, etc.
  fileUrl            String             @map("file_url")
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION PLANS
// ─────────────────────────────────────────────

model Plan {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Decimal      @db.Decimal(10, 2) @default(0)
  currency        String       @default("INR")
  billingCycle    BillingCycle @default(MONTHLY) @map("billing_cycle")
  isActive        Boolean      @default(true) @map("is_active")
  isPrivate       Boolean      @default(false) @map("is_private")  // if true, only clientId can see it
  clientId        String?      @map("client_id") @db.Uuid          // null = public
  stripeProductId String?      @map("stripe_product_id")
  stripePriceId   String?      @map("stripe_price_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]
  client        Client?        @relation("ClientPrivatePlans", fields: [clientId], references: [id])

  @@map("plans")
}

model PlanFeature {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @map("plan_id") @db.Uuid
  name        String
  description String?
  value       String?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_features")
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  clientId    String             @map("client_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime?          @map("start_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  renewalDate DateTime?          @map("renewal_date") @db.Date
  notes       String?
  stripeSubId String?            @map("stripe_subscription_id")
  createdById String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  client    Client    @relation(fields: [clientId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])
  createdBy Profile?  @relation(fields: [createdById], references: [id])
  payments  Payment[]

  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  progress    Int           @default(0)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  leadId      String?       @map("lead_id") @db.Uuid
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  client    Client          @relation(fields: [clientId], references: [id])
  lead      Profile?        @relation("ProjectLead", fields: [leadId], references: [id])
  createdBy Profile?        @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  members   ProjectMember[]
  milestones Milestone[]
  tasks     Task[]
  updates   ProjectUpdate[]
  invoices  Invoice[]
  documents Document[]
  approvals ClientApproval[]

  @@map("projects")
}

model ProjectMember {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  role      String @default("MEMBER")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// MILESTONES
// ─────────────────────────────────────────────

model Milestone {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  name          String
  description   String?
  status        MilestoneStatus @default(PLANNED)
  progress      Int             @default(0)
  dueDate       DateTime?       @map("due_date") @db.Date
  completedDate DateTime?       @map("completed_date") @db.Date
  clientVisible Boolean         @default(false) @map("client_visible") // shown to client only when COMPLETED
  sortOrder     Int             @default(0) @map("sort_order")
  // Assignment
  assigneeId    String?         @map("assignee_id") @db.Uuid
  assigneeRole  String?         @map("assignee_role")  // DEVELOPER | TESTER
  autoAssign    Boolean         @default(false) @map("auto_assign")
  createdById   String?         @map("created_by") @db.Uuid
  imageUrls     String[]        @default([]) @map("image_urls")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  assignee  Profile? @relation("MilestoneAssignee", fields: [assigneeId], references: [id])
  createdBy Profile? @relation("MilestoneCreatedBy", fields: [createdById], references: [id])

  @@map("milestones")
}

// ─────────────────────────────────────────────
// CLIENT APPROVALS (lead creates, client responds)
// ─────────────────────────────────────────────

model ClientApproval {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @map("project_id") @db.Uuid
  clientId    String               @map("client_id") @db.Uuid
  title       String
  description String?
  status      ClientApprovalStatus @default(PENDING)
  clientNote  String?              @map("client_note")
  respondedAt DateTime?            @map("responded_at")
  createdById String?              @map("created_by") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id])
  createdBy Profile? @relation("ApprovalCreatedBy", fields: [createdById], references: [id])

  @@map("client_approvals")
}

// ─────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  milestoneId   String?      @map("milestone_id") @db.Uuid
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  assigneeId    String?      @map("assignee_id") @db.Uuid
  developerId   String?      @map("developer_id") @db.Uuid
  testerId      String?      @map("tester_id") @db.Uuid
  dueDate       DateTime?    @map("due_date") @db.Date
  clientVisible Boolean      @default(false) @map("client_visible") // INTERNAL by default
  createdById   String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?    @relation(fields: [milestoneId], references: [id])
  assignee  Profile?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  developer Profile?      @relation("TaskDeveloper", fields: [developerId], references: [id])
  tester    Profile?      @relation("TaskTester", fields: [testerId], references: [id])
  createdBy Profile?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  comments   TaskComment[]
  activities TaskActivity[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id])

  @@map("task_comments")
}

model TaskActivity {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   // CREATED, STATUS_CHANGED, REASSIGNED, COMMENTED
  fromValue   String?  @map("from_value")
  toValue     String?  @map("to_value")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  task  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Profile? @relation(fields: [actorId], references: [id])

  @@map("task_activities")
}

// ─────────────────────────────────────────────
// PROJECT UPDATES (client-facing)
// ─────────────────────────────────────────────

model ProjectUpdate {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  title         String
  content       String
  authorId      String?  @map("author_id") @db.Uuid
  clientVisible Boolean  @default(true) @map("client_visible")
  createdAt     DateTime @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Profile? @relation(fields: [authorId], references: [id])

  @@map("project_updates")
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceNo   String        @unique @map("invoice_no")
  clientId    String        @map("client_id") @db.Uuid
  projectId   String?       @map("project_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  subtotal    Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxRate     Decimal       @default(18) @map("tax_rate") @db.Decimal(5, 2)
  currency    String        @default("INR")
  status      InvoiceStatus @default(PENDING)
  issuedDate  DateTime      @default(now()) @map("issued_date") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  paidDate    DateTime?     @map("paid_date") @db.Date
  notes       String?
  lineItems   Json?         @map("line_items")
  pdfUrl      String?       @map("pdf_url")
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  client    Client    @relation(fields: [clientId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  createdBy Profile?  @relation(fields: [createdById], references: [id])
  payments  Payment[]
  documents Document[]

  @@map("invoices")
}

// ─────────────────────────────────────────────
// PAYMENTS (Stripe)
// ─────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String?       @map("invoice_id") @db.Uuid
  subscriptionId  String?       @map("subscription_id") @db.Uuid
  stripePaymentId String?       @unique @map("stripe_payment_id")
  stripeSessionId String?       @map("stripe_session_id")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  fileUrl      String     @map("file_url")
  fileType     String?    @map("file_type")
  fileSize     Int?       @map("file_size")
  clientId     String?    @map("client_id") @db.Uuid
  projectId    String?    @map("project_id") @db.Uuid
  invoiceId    String?    @map("invoice_id") @db.Uuid
  uploadedById String?    @map("uploaded_by") @db.Uuid
  visibility   Visibility @default(CLIENT_VISIBLE)
  createdAt    DateTime   @default(now()) @map("created_at")

  client     Client?  @relation(fields: [clientId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  uploadedBy Profile? @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String
  message    String?
  type       String   @default("INFO")
  isRead     Boolean  @default(false) @map("is_read")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOG TRAIL
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  actorRole   String?  @map("actor_role")
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, STATUS_CHANGE, etc.
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS
// ─────────────────────────────────────────────

model AppSettings {
  id             String   @id @default(uuid()) @db.Uuid
  companyName    String   @default("Tvita Digital") @map("company_name")
  companyEmail   String?  @map("company_email")
  companyPhone   String?  @map("company_phone")
  companyAddress String?  @map("company_address")
  companyGstin   String?  @map("company_gstin")
  companyPan     String?  @map("company_pan")
  companyState   String?  @map("company_state")
  bankName       String?  @map("bank_name")
  bankAccount    String?  @map("bank_account")
  bankIfsc       String?  @map("bank_ifsc")
  bankBranch     String?  @map("bank_branch")
  invoicePrefix  String   @default("INV") @map("invoice_prefix")
  invoiceFooter  String?  @map("invoice_footer")
  currency       String   @default("INR")
  taxRate        Decimal  @default(18) @map("tax_rate") @db.Decimal(5, 2)
  
  smtpHost       String?  @default("smtp.gmail.com") @map("smtp_host")
  smtpPort       Int?     @default(587) @map("smtp_port")
  smtpUser       String?  @map("smtp_user")
  smtpPass       String?  @map("smtp_pass")
  smtpSender     String?  @map("smtp_sender")

  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
